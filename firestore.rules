rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allows anyone to read approved feedbacks
    match /feedbacks/{feedbackId} {
      allow read: if resource.data.isApproved == true || request.auth != null;
      allow create: if true; // In a production app, you'd add more validation
      allow update, delete: if request.auth != null;
    }

    // Allows anyone to submit inquiries
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Site stats
    match /site_stats/{docId} {
      allow read: if true;
      allow update: if true; // We use increment() for views/reactions
      allow create, delete: if request.auth != null;
    }

    // Feedback codes
    match /feedback_codes/{codeId} {
      allow read: if true;
      allow update: if true;
      allow create, delete: if request.auth != null;
    }
  }
}
