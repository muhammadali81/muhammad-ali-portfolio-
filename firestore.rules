rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAdmin() {
      return request.auth != null && 
             request.auth.token.email == 'alimuhammadhvn81@gmail.com' && 
             request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /feedbacks/{feedbackId} {
      allow read: if resource.data.isApproved == true || isAdmin();
      
      // Anyone can create feedback
      allow create: if true; 
      
      // Admin can update or delete
      allow update, delete: if isAdmin();
    }
    
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }
    
    match /feedbackCodes/{codeId} {
      // Anyone can read a code to check if it's valid/used
      allow read: if true;
      
      // Admin can do anything
      allow create, delete: if isAdmin();
      
      // Anyone can mark a code as used when they submit a feedback
      // We should ideally restrict this to just updating `isUsed` and `usedAt`
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isUsed', 'usedAt']) &&
        request.resource.data.isUsed == true
      );
    }
  }
}
